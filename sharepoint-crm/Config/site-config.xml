<?xml version="1.0" encoding="utf-8"?>
<SiteConfiguration xmlns="http://schemas.microsoft.com/sharepoint/2014/app">
  <!-- SharePoint CRM Site Configuration -->
  <!-- This file defines the overall site structure and settings for the CRM system -->

  <!-- Site Information -->
  <SiteInfo>
    <Title>Customer Service CRM</Title>
    <Description>Customer Relationship Management System for handling support tickets, customer information, and knowledge base management</Description>
    <Language>1033</Language> <!-- English -->
    <Locale>en-US</Locale>
    <TimeZone>Pacific Standard Time</TimeZone>
    <CalendarType>Gregorian</CalendarType>
    <WorkDays>Monday,Tuesday,Wednesday,Thursday,Friday</WorkDays>
    <WorkDayStart>09:00:00</WorkDayStart>
    <WorkDayEnd>18:00:00</WorkDayEnd>
    <IsPublicSite>false</IsPublicSite>
  </SiteInfo>

  <!-- Navigation Structure -->
  <Navigation>
    <TopNavigation>
      <Link Title="Dashboard" Url="SitePages/Dashboard.aspx" DisplayOrder="1" />
      <Link Title="Tickets" Url="Lists/CRM%20Tickets/AllItems.aspx" DisplayOrder="2" />
      <Link Title="Customers" Url="Lists/CRM%20Customers/AllItems.aspx" DisplayOrder="3" />
      <Link Title="Knowledge Base" Url="Lists/CRM%20Knowledge%20Articles/AllItems.aspx" DisplayOrder="4" />
      <Link Title="Reports" Url="SitePages/Reports.aspx" DisplayOrder="5" />
      <Link Title="Settings" Url="SitePages/Settings.aspx" DisplayOrder="6" />
    </TopNavigation>

    <QuickLaunch>
      <Heading Title="Ticket Management">
        <Link Title="My Tickets" Url="Lists/CRM%20Tickets/MyTickets.aspx" />
        <Link Title="Unassigned Tickets" Url="Lists/CRM%20Tickets/Unassigned.aspx" />
        <Link Title="Create New Ticket" Url="Lists/CRM%20Tickets/NewForm.aspx" />
        <Link Title="Ticket Reports" Url="SitePages/TicketReports.aspx" />
      </Heading>

      <Heading Title="Customer Management">
        <Link Title="All Customers" Url="Lists/CRM%20Customers/AllItems.aspx" />
        <Link Title="Active Customers" Url="Lists/CRM%20Customers/ActiveCustomers.aspx" />
        <Link Title="Add New Customer" Url="Lists/CRM%20Customers/NewForm.aspx" />
        <Link Title="Customer Reports" Url="SitePages/CustomerReports.aspx" />
      </Heading>

      <Heading Title="Knowledge Management">
        <Link Title="Published Articles" Url="Lists/CRM%20Knowledge%20Articles/PublishedArticles.aspx" />
        <Link Title="Draft Articles" Url="Lists/CRM%20Knowledge%20Articles/DraftArticles.aspx" />
        <Link Title="Create Article" Url="Lists/CRM%20Knowledge%20Articles/NewForm.aspx" />
        <Link Title="Most Viewed" Url="Lists/CRM%20Knowledge%20Articles/MostViewed.aspx" />
      </Heading>

      <Heading Title="Team Management">
        <Link Title="Agents" Url="Lists/CRM%20Agents/AllItems.aspx" />
        <Link Title="Available Agents" Url="Lists/CRM%20Agents/AvailableAgents.aspx" />
        <Link Title="SLA Rules" Url="Lists/CRM%20SLA%20Rules/AllItems.aspx" />
        <Link Title="Team Performance" Url="SitePages/TeamPerformance.aspx" />
      </Heading>

      <Heading Title="Administration">
        <Link Title="Site Settings" Url="_layouts/15/settings.aspx" />
        <Link Title="Site Permissions" Url="_layouts/15/user.aspx" />
        <Link Title="Site Content" Url="_layouts/15/viewlsts.aspx" />
        <Link Title="Site Usage" Url="_layouts/15/usagedetails.aspx" />
      </Heading>
    </QuickLaunch>
  </Navigation>

  <!-- Site Pages Configuration -->
  <SitePages>
    <!-- Dashboard Pages -->
    <Page Name="Dashboard.aspx" Title="CRM Dashboard" Layout="DefaultLayout.aspx" Publish="true">
      <WebParts>
        <WebPart Name="TicketSummary" Zone="Main" Order="1" />
        <WebPart Name="SLADashboard" Zone="Main" Order="2" />
        <WebPart Name="RecentActivity" Zone="Main" Order="3" />
        <WebPart Name="QuickActions" Zone="Main" Order="4" />
      </WebParts>
    </Page>

    <Page Name="AgentDashboard.aspx" Title="Agent Dashboard" Layout="DefaultLayout.aspx" Publish="true">
      <WebParts>
        <WebPart Name="MyTickets" Zone="Main" Order="1" />
        <WebPart Name="MyPerformance" Zone="Main" Order="2" />
        <WebPart Name="KnowledgeSearch" Zone="Main" Order="3" />
        <WebPart Name="TeamStatus" Zone="Main" Order="4" />
      </WebParts>
    </Page>

    <!-- Customer Portal Pages -->
    <Page Name="CustomerPortal.aspx" Title="Customer Portal" Layout="DefaultLayout.aspx" Publish="true">
      <WebParts>
        <WebPart Name="MyTickets" Zone="Main" Order="1" />
        <WebPart Name="CreateTicket" Zone="Main" Order="2" />
        <WebPart Name="KnowledgeSearch" Zone="Main" Order="3" />
        <WebPart Name="AccountInfo" Zone="Main" Order="4" />
      </WebParts>
    </Page>

    <!-- Report Pages -->
    <Page Name="Reports.aspx" Title="Reports Dashboard" Layout="DefaultLayout.aspx" Publish="true">
      <WebParts>
        <WebPart Name="TicketVolume" Zone="Main" Order="1" />
        <WebPart Name="SLACompliance" Zone="Main" Order="2" />
        <WebPart Name="CustomerSatisfaction" Zone="Main" Order="3" />
        <WebPart Name="AgentPerformance" Zone="Main" Order="4" />
      </WebParts>
    </Page>

    <Page Name="TicketReports.aspx" Title="Ticket Reports" Layout="DefaultLayout.aspx" Publish="true">
      <WebParts>
        <WebPart Name="TicketTrends" Zone="Main" Order="1" />
        <WebPart Name="ResolutionTimes" Zone="Main" Order="2" />
        <WebPart Name="CategoryBreakdown" Zone="Main" Order="3" />
      </WebParts>
    </Page>

    <Page Name="CustomerReports.aspx" Title="Customer Reports" Layout="DefaultLayout.aspx" Publish="true">
      <WebParts>
        <WebPart Name="CustomerGrowth" Zone="Main" Order="1" />
        <WebPart Name="AccountTypes" Zone="Main" Order="2" />
        <WebPart Name="TopCustomers" Zone="Main" Order="3" />
      </WebParts>
    </Page>

    <!-- Settings and Administration Pages -->
    <Page Name="Settings.aspx" Title="CRM Settings" Layout="DefaultLayout.aspx" Publish="true">
      <WebParts>
        <WebPart Name="SLASettings" Zone="Main" Order="1" />
        <WebPart Name="NotificationSettings" Zone="Main" Order="2" />
        <WebPart Name="IntegrationSettings" Zone="Main" Order="3" />
      </WebParts>
    </Page>

    <Page Name="TeamPerformance.aspx" Title="Team Performance" Layout="DefaultLayout.aspx" Publish="true">
      <WebParts>
        <WebPart Name="AgentMetrics" Zone="Main" Order="1" />
        <WebPart Name="TeamProductivity" Zone="Main" Order="2" />
        <WebPart Name="WorkloadBalance" Zone="Main" Order="3" />
      </WebParts>
    </Page>
  </SitePages>

  <!-- Content Types Configuration -->
  <ContentTypes>
    <ContentType Name="CRM Ticket" ParentID="0x01" Group="CRM Content Types">
      <Fields>
        <FieldRef ID="{fa564e0f-0c70-4ab9-b863-0177e6ddd247}" Name="Title" Required="TRUE" />
        <FieldRef ID="{82642ec8-ef9b-478f-acf2-3115ff7b3b84}" Name="Description" Required="TRUE" />
        <FieldRef ID="{b23b5c1e-1a1c-4b2c-9f4a-3a5b4d6e7f8g}" Name="CustomerID" Required="TRUE" />
        <FieldRef ID="{1f5b5c2e-2a2c-5b3c-0g5a-4a6b5d7e8f9h}" Name="AssignedTo" Required="FALSE" />
        <FieldRef ID="{2c6b3d2f-3b3d-6c4d-1h6b-5b7c6e8f9g0i}" Name="Status" Required="TRUE" />
        <FieldRef ID="{3d7b4e3f-4c4e-7d5e-2i7c-6c8d7f9g0h1j}" Name="Priority" Required="TRUE" />
        <FieldRef ID="{4e8c5f4f-5d5f-8e6f-3j8d-7d9e8g0h1i2k}" Name="Category" Required="TRUE" />
      </Fields>
    </ContentType>

    <ContentType Name="CRM Customer" ParentID="0x01" Group="CRM Content Types">
      <Fields>
        <FieldRef ID="{fa564e0f-0c70-4ab9-b863-0177e6ddd247}" Name="Title" Required="TRUE" />
        <FieldRef ID="{7c5b6d3e-4c4e-5d5f-8e9f-0a1b2c3d4e5f}" Name="ContactName" Required="TRUE" />
        <FieldRef ID="{8d6b7e4f-5d5f-6e6g-9f0a-1b2c3d4e5f6g}" Name="Email" Required="TRUE" />
        <FieldRef ID="{c1afj8j-9h9j-0i0k-3d4e-5f6g7h8i9j0k}" Name="AccountStatus" Required="FALSE" />
        <FieldRef ID="{d2bg0k9k-0i0k-1j1l-4e5f-6g7h8i9j0k1l}" Name="AccountType" Required="FALSE" />
      </Fields>
    </ContentType>

    <ContentType Name="CRM Knowledge Article" ParentID="0x01" Group="CRM Content Types">
      <Fields>
        <FieldRef ID="{fa564e0f-0c70-4ab9-b863-0177e6ddd247}" Name="Title" Required="TRUE" />
        <FieldRef ID="{7c5b6d3e-4c4e-5d5f-8e9f-0a1b2c3d4e5f}" Name="ArticleBody" Required="TRUE" />
        <FieldRef ID="{8d6b7e4f-5d5f-6e6g-9f0a-1b2c3d4e5f6g}" Name="Category" Required="TRUE" />
        <FieldRef ID="{d2bg0k9k-0i0k-1j1l-4e5f-6g7h8i9j0k1l}" Name="Status" Required="TRUE" />
        <FieldRef ID="{e3ch1l0l-1j1l-2k2m-5f6g-7h8i9j0k1l2m}" Name="Author" Required="TRUE" />
      </Fields>
    </ContentType>
  </ContentTypes>

  <!-- Search Configuration -->
  <SearchConfiguration>
    <SearchCenterUrl>/search</SearchCenterUrl>
    <DisplayInSearch>true</DisplayInSearch>
    <SearchScopes>
      <Scope Name="CRM Tickets" Url="Lists/CRM Tickets" />
      <Scope Name="CRM Customers" Url="Lists/CRM Customers" />
      <Scope Name="Knowledge Base" Url="Lists/CRM Knowledge Articles" />
    </SearchScopes>
    <CustomSearchResults>
      <ResultSource Name="CRM Search Results" QueryTemplate="contentclass:STS_ListItem AND path:{SiteCollection.Url}" />
    </CustomSearchResults>
  </SearchConfiguration>

  <!-- Audit Settings -->
  <AuditSettings>
    <Enabled>true</Enabled>
    <AuditLogRetentionDays>2555</AuditLogRetentionDays>
    <AuditTriggers>
      <Trigger Type="ListItemCreate" Enabled="true" />
      <Trigger Type="ListItemUpdate" Enabled="true" />
      <Trigger Type="ListItemDelete" Enabled="true" />
      <Trigger Type="UserLogin" Enabled="true" />
      <Trigger Type="PermissionChange" Enabled="true" />
      <Trigger Type="SchemaChange" Enabled="true" />
    </AuditTriggers>
  </AuditSettings>

  <!-- Web Template Configuration -->
  <WebTemplate>
    <Name>CRM_SITE_TEMPLATE</Name>
    <Title>Customer Service CRM Site</Title>
    <Description>A pre-configured site for customer service ticket management and customer relationship management</Description>
    <PreviewImageUrl="/_layouts/15/images/siteicon.png</PreviewImageUrl>
    <BaseTemplateID="STS#0</BaseTemplateID>
    <DisplayCategory>Enterprise</DisplayCategory>
  </WebTemplate>

  <!-- Feature Configuration -->
  <Features>
    <Feature ID="00bfea71-de22-43b2-a848-c05709e907eb" Activate="true" Description="Team Collaboration Lists" />
    <Feature ID="00bfea71-5932-4f9b-ad71-d16174a39411" Activate="true" Description="Navigation" />
    <Feature ID="00bfea71-4ea5-48d4-a4ad-305cf7030140" Activate="true" Description="Mobility" />
    <Feature ID="00bfea71-d1fe-4ce8-9a99-07eb4622e718" Activate="true" Description="Document Management" />
    <Feature ID="00bfea71-6798-43e8-90c2-789b6c3e9222" Activate="true" Description="Search" />
    <Feature ID="f9ce21f8-f437-4f7e-8bc6-9f3f3af0a4b4" Activate="true" Description="Publishing" />
  </Features>

  <!-- Regional Settings -->
  <RegionalSettings>
    <CalendarType>1</CalendarType>
    <WorkDays>31</WorkDays> <!-- Monday-Friday -->
    <FirstDayOfWeek>0</FirstDayOfWeek> <!-- Sunday -->
    <FirstWeekOfYear>0</FirstWeekOfYear> <!-- First full week -->
    <Time24>false</Time24>
    <ShowWeeks>true</ShowWeeks>
    <AlternateCalendarType>1</AlternateCalendarType>
  </RegionalSettings>

  <!-- External Sharing Settings -->
  <ExternalSharing>
    <Enabled>true</Enabled>
    <SharingCapabilities>ExternalUserAndGuestSharing</SharingCapabilities>
    <GuestSignInEnabled>true</GuestSignInEnabled>
    <RequireAnonymousLinksExpireInDays>365</RequireAnonymousLinksExpireInDays>
    <DefaultLinkPermission>View</DefaultLinkPermission>
    <PreventExternalUsersFromResharing>true</PreventExternalUsersFromResharing>
  </ExternalSharing>

  <!-- Mobile Configuration -->
  <MobileSettings>
    <MobileViewEnabled>true</MobileViewEnabled>
    <ModernPageExperience>true</ModernPageExperience>
    <ResponsiveDesignEnabled>true</ResponsiveDesignEnabled>
  </MobileSettings>

  <!-- Performance Settings -->
  <PerformanceSettings>
    <EnableMinification>true</EnableMinification>
    <EnableCdn>true</EnableCdn>
    <CacheSettings>
      <BrowserCacheDuration>86400</BrowserCacheDuration> <!-- 24 hours -->
      <ServerCacheDuration>300</ServerCacheDuration> <!-- 5 minutes -->
    </CacheSettings>
  </PerformanceSettings>
</SiteConfiguration>