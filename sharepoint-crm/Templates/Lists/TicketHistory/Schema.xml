    <Views>
      <View BaseViewID="1" Type="HTML" WebPartZoneID="Main" DisplayName="All History" DefaultView="TRUE" MobileView="TRUE" MobileDefaultView="TRUE" SetupPath="pages\viewpage.aspx" ImageUrl="/_layouts/15/images/generic.png?rev=47" Url="AllItems.aspx">
        <ViewFields>
          <FieldRef Name="TicketID" />
          <FieldRef Name="Title" />
          <FieldRef Name="ActionType" />
          <FieldRef Name="ActionedBy" />
          <FieldRef Name="ActionDate" />
          <FieldRef Name="Visibility" />
        </ViewFields>
        <RowLimit Paged="TRUE">50</RowLimit>
        <Query>
          <OrderBy>
            <FieldRef Name="ActionDate" Ascending="FALSE" />
          </OrderBy>
        </Query>
      </View>
      <View BaseViewID="2" Type="HTML" WebPartZoneID="Main" DisplayName="Customer Visible" SetupPath="pages\viewpage.aspx" ImageUrl="/_layouts/15/images/generic.png?rev=47" Url="CustomerVisible.aspx">
        <ViewFields>
          <FieldRef Name="TicketID" />
          <FieldRef Name="Title" />
          <FieldRef Name="ActionType" />
          <FieldRef Name="ActionedBy" />
          <FieldRef Name="ActionDate" />
          <FieldRef Name="Description" />
        </ViewFields>
        <RowLimit Paged="TRUE">50</RowLimit>
        <Query>
          <Where>
            <Or>
              <Eq>
                <FieldRef Name="Visibility" />
                <Value Type="Text">Customer Visible</Value>
              </Eq>
              <Eq>
                <FieldRef Name="Visibility" />
                <Value Type="Text">Public</Value>
              </Eq>
            </Or>
          </Where>
          <OrderBy>
            <FieldRef Name="ActionDate" Ascending="FALSE" />
          </OrderBy>
        </Query>
      </View>
      <View BaseViewID="3" Type="HTML" WebPartZoneID="Main" DisplayName="By Ticket" SetupPath="pages\viewpage.aspx" ImageUrl="/_layouts/15/images/generic.png?rev=47" Url="ByTicket.aspx">
        <ViewFields>
          <FieldRef Name="Title" />
          <FieldRef Name="ActionType" />
          <FieldRef Name="ActionedBy" />
          <FieldRef Name="ActionDate" />
          <FieldRef Name="Visibility" />
        </ViewFields>
        <RowLimit Paged="TRUE">50</RowLimit>
        <Query>
          <OrderBy>
            <FieldRef Name="TicketID" />
            <FieldRef Name="ActionDate" Ascending="FALSE" />
          </OrderBy>
        </Query>
        <GroupBy Collapse="TRUE" GroupLimit="50">
          <FieldRef Name="TicketID" />
        </GroupBy>
      </View>
      <View BaseViewID="4" Type="HTML" WebPartZoneID="Main" DisplayName="Recent Activity" SetupPath="pages\viewpage.aspx" ImageUrl="/_layouts/15/images/generic.png?rev=47" Url="RecentActivity.aspx">
        <ViewFields>
          <FieldRef Name="TicketID" />
          <FieldRef Name="Title" />
          <FieldRef Name="ActionType" />
          <FieldRef Name="ActionedBy" />
          <FieldRef Name="ActionDate" />
        </ViewFields>
        <RowLimit Paged="TRUE">25</RowLimit>
        <Query>
          <Where>
            <Geq>
              <FieldRef Name="ActionDate" />
              <Value Type="DateTime">
                <Today OffsetDays="-7" />
              </Value>
            </Geq>
          </Where>
          <OrderBy>
            <FieldRef Name="ActionDate" Ascending="FALSE" />
          </OrderBy>
        </Query>
      </View>
    </Views>
