# Server Configuration
PORT=5001
NODE_ENV=development

# Microsoft Azure AD Configuration
AZURE_CLIENT_ID=your-azure-client-id
AZURE_CLIENT_SECRET=your-azure-client-secret
AZURE_TENANT_ID=your-azure-tenant-id
AZURE_REDIRECT_URI=http://localhost:5001/auth/callback

# Microsoft Graph API
GRAPH_API_ENDPOINT=https://graph.microsoft.com/v1.0

# JWT Configuration
JWT_SECRET=your-jwt-secret-key
JWT_EXPIRES_IN=24h

# Dataverse Configuration
DATAVERSE_URL=your-dataverse-url
DATAVERSE_CLIENT_ID=your-dataverse-client-id
DATAVERSE_CLIENT_SECRET=your-dataverse-client-secret

# Power Automate Configuration
POWER_AUTOMATE_WEBHOOK_URL=your-power-automate-webhook-url

# SharePoint Configuration
SHAREPOINT_SITE_URL=your-sharepoint-site-url
SHAREPOINT_LIBRARY=Documents

# Email Configuration
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_USER=your-email@domain.com
EMAIL_PASS=your-email-password

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads